page {
  min-height: 100%;
  background: #fdfcf8;
  color: #1a1a2e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", sans-serif;
}

view, text, button, input, picker, textarea {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1;
  width: auto;
}

button::after {
  border: 0;
}
