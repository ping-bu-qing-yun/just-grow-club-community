}

.bridge {
  width: 94rpx;
  height: 34rpx;
  border-top: 4rpx solid #6b8e6b;
  border-radius: 50% 50% 0 0;
  position: absolute;
  top: 18rpx;
  left: 133rpx;
}

.bridge::after {
  content: "";
  position: absolute;
  left: 40rpx;
  top: 56rpx;
  width: 20rpx;
  height: 4rpx;
