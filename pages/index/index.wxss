.demand-card-stage {
  position: relative;
  height: 300rpx;
  margin-top: 18rpx;
  perspective: 1000rpx;
}

.demand-face {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 30rpx;
  border-radius: 28rpx;
  backface-visibility: hidden;
  transition: transform .45s ease;
}

.demand-front {
  background: linear-gradient(135deg, #6b8e6b, #e8f4ed);
  color: #fff;
}

.demand-back {
  background: #fffaf4;
  border: 1rpx solid #eadfce;
  color: #1a1a2e;
  transform: rotateY(180deg);
}

.demand-card-stage.is-flipped .demand-front { transform: rotateY(180deg); }
.demand-card-stage.is-flipped .demand-back { transform: rotateY(360deg); }

