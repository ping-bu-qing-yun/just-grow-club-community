  padding: 0 20rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid rgba(26,26,46,.08);
}

.settings-row {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(26,26,46,.08);
  color: #1a1a2e;
  font-size: 23rpx;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-row text:last-child {
  color: #929991;
  font-size: 20rpx;
  text-align: right;
}

.logout-btn {
  width: 100%;
  height: 82rpx;
  margin-top: 24rpx;
  border-radius: 20rpx;
  background: #fff0e8;
  color: #b65a37;
  font-size: 24rpx;
  font-weight: 900;
}

.settings-note {
  margin-top: 16rpx;
  text-align: center;
}

/* Recommended cards use the same fixed rhythm as the activity feed. */
.rec-card {
  height: 360rpx;
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
}

.rec-cover {
  flex: 0 0 128rpx;
  height: 128rpx;
  min-height: 128rpx;
}

.rec-body {
  flex: 0 0 232rpx;
  height: 232rpx;
  min-height: 232rpx;
  display: flex;
  flex-direction: column;
}

.rec-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.rec-actions {
  margin-top: auto;
}
