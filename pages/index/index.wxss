.page {
  min-height: 100vh;
  background: #fdfcf8;
}

button::after {
  border: 0;
}

.intro-screen {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: #fdfcf8;
}

.intro-cup {
  position: absolute;
  top: 42%;
  width: 88rpx;
  height: 112rpx;
  border: 4rpx solid #6b8e6b;
  border-radius: 50%;
  opacity: 0;
  animation: intro-cup-in .7s ease-out forwards;
}

.intro-cup::after {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 24rpx;
  width: 60rpx;
  height: 4rpx;
  background: #6b8e6b;
  transform: rotate(45deg);
}

.intro-cup-left { left: 22%; }
.intro-cup-right { right: 22%; animation-delay: .16s; }

.intro-line {
  position: absolute;
  top: calc(42% + 18rpx);
  left: 38%;
  width: 24%;
  height: 4rpx;
  background: #d97757;
  transform: scaleX(0);
  transform-origin: left center;
  animation: intro-line-in .8s .45s ease-out forwards;
}

.intro-word {
  position: absolute;
  width: 100%;
  top: calc(42% + 160rpx);
  text-align: center;
  color: #4a6b4a;
  font-size: 42rpx;
  font-weight: 900;
  opacity: 0;
  animation: intro-word-in .6s 1s ease-out forwards;
}

@keyframes intro-cup-in {
  from { opacity: 0; transform: scale(.8); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes intro-line-in {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

@keyframes intro-word-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.screen {
  height: 100vh;
  padding: 122rpx 28rpx 40rpx;
  background: #fdfcf8;
}

.with-tab {
  padding-bottom: 164rpx;
}

.app-header {
  position: fixed;
  z-index: 12;
  left: 0;
  right: 0;
  top: 0;
  height: 96rpx;
  padding: 0 28rpx;
  background: rgba(253,252,248,.96);
  border-bottom: 1rpx solid rgba(26,26,46,.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-back, .header-right {
  width: 76rpx;
  height: 76rpx;
}

.header-back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0;
  color: #4a6b4a;
  font-size: 58rpx;
  line-height: 1;
  text-align: left;
}

.app-header-title {
  flex: 1;
  color: #1a1a2e;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
}

.welcome-screen {
  min-height: 100vh;
  padding: 80rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #fdfcf8, #e8f4ed);
}

.cup-logo {
  width: 360rpx;
  height: 144rpx;
  margin-bottom: 56rpx;
  position: relative;
}

.lens {
  width: 92rpx;
  height: 110rpx;
  border: 4rpx solid #6b8e6b;
  border-radius: 50%;
  position: absolute;
  top: 18rpx;
}

.lens::after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 24rpx;
  width: 62rpx;
  height: 4rpx;
  background: #6b8e6b;
  transform: rotate(45deg);
}

.lens.left {
  left: 42rpx;
}

.lens.right {
  right: 42rpx;
}

.bridge {
  width: 94rpx;
  height: 34rpx;
  border-top: 4rpx solid #6b8e6b;
  border-radius: 50% 50% 0 0;
  position: absolute;
  top: 18rpx;
  left: 133rpx;
}

.bridge::after {
  content: "";
  position: absolute;
  left: 40rpx;
  top: 56rpx;
  width: 20rpx;
  height: 4rpx;
  background: #6b8e6b;
}

.welcome-title {
