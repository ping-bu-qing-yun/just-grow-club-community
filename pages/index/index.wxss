  top: 18rpx;
}

.lens::after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 24rpx;
  width: 62rpx;
  height: 4rpx;
  background: #6b8e6b;
  transform: rotate(45deg);
}

.lens.left {
  left: 42rpx;
}

.lens.right {
