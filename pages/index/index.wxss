.page {
  min-height: 100vh;
  background: #fdfcf8;
}

button::after {
  border: 0;
}

.intro-screen {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: #fdfcf8;
}

.intro-cup {
  position: absolute;
  top: 42%;
  width: 88rpx;
  height: 112rpx;
  border: 4rpx solid #6b8e6b;
  border-radius: 50%;
  opacity: 0;
  animation: intro-cup-in .7s ease-out forwards;
}

.intro-cup::after {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 24rpx;
  width: 60rpx;
  height: 4rpx;
  background: #6b8e6b;
  transform: rotate(45deg);
}

.intro-cup-left { left: 22%; }
.intro-cup-right { right: 22%; animation-delay: .16s; }

.intro-line {
  position: absolute;
  top: calc(42% + 18rpx);
  left: 38%;
  width: 24%;
  height: 4rpx;
  background: #d97757;
  transform: scaleX(0);
  transform-origin: left center;
  animation: intro-line-in .8s .45s ease-out forwards;
}

.intro-word {
  position: absolute;
  width: 100%;
  top: calc(42% + 160rpx);
  text-align: center;
  color: #4a6b4a;
  font-size: 42rpx;
  font-weight: 900;
  opacity: 0;
  animation: intro-word-in .6s 1s ease-out forwards;
}

@keyframes intro-cup-in {
  from { opacity: 0; transform: scale(.8); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes intro-line-in {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

@keyframes intro-word-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.screen {
  height: 100vh;
  padding: 122rpx 28rpx 40rpx;
  background: #fdfcf8;
  box-sizing: border-box;
}

.with-tab {
