}

.explore-tags text {
  font-size: 18rpx;
  color: #416054;
  background: #eff5f1;
  padding: 6rpx 14rpx;
  border-radius: 99rpx;
}

.explore-empty {
  text-align: center;
  padding: 80rpx 0;
}

.explore-empty-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #2f2a24;
}

.explore-clear {
  margin-top: 20rpx;
  padding: 14rpx 40rpx;
  border: 1rpx solid rgba(95, 127, 94, .24);
  border-radius: 99rpx;
  background: #fff;
  color: #416054;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.club-profile {
  position: relative;
}

.profile-cover {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 340rpx;
  background: linear-gradient(145deg, #314a43, #87a485);
  border-radius: 0 0 48rpx 48rpx;
}

.profile-identity {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 60rpx 10rpx 24rpx;
}

.profile-avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, .8);
  box-shadow: 0 14rpx 30rpx rgba(44, 57, 43, .2);
  background: #eef3ee;
}

.profile-idtext {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 900;
  color: #fff;
}

.profile-type {
  font-size: 24rpx;
  color: rgba(255, 255, 255, .85);
  margin-top: 8rpx;
}

.profile-edit {
  background: rgba(255, 255, 255, .2);
  border: 1rpx solid rgba(255, 255, 255, .4);
  color: #fff;
  font-size: 22rpx;
  border-radius: 99rpx;
  padding: 10rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trust-strip {
  display: flex;
  gap: 20rpx;
  margin: 6rpx 0 22rpx;
}

.trust-strip text {
  font-size: 20rpx;
  color: #416054;
  background: #e8f4ed;
  border-radius: 99rpx;
  padding: 8rpx 18rpx;
}

.portrait-progress {
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx;
  box-shadow: 0 12rpx 28rpx rgba(63, 47, 38, .08);
  margin-bottom: 20rpx;
}

.pp-head {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  font-weight: 850;
  color: #2f2a24;
}

.pp-track {
  height: 14rpx;
  background: #f0ece1;
  border-radius: 99rpx;
  margin-top: 18rpx;
  overflow: hidden;
}

.pp-fill {
  height: 100%;
  background: linear-gradient(90deg, #6f916c, #587b59);
  border-radius: 99rpx;
}

.pp-hint {
  font-size: 22rpx;
  color: #8a867c;
  margin-top: 14rpx;
  line-height: 1.6;
}

.profile-promos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.profile-promos button {
  background: linear-gradient(145deg, #fff 0% 48%, #f1f8f3 100%);
  border: 1rpx solid #dce9df;
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  text-align: left;
  display: flex;
  flex-direction: column;
}

.profile-promos button.orange {
  background: linear-gradient(145deg, #fff 0% 48%, #fff4ef 100%);
  border-color: #f0d9cc;
}

.promo-title {
  font-size: 28rpx;
  font-weight: 850;
  color: #2f2a24;
}

.promo-sub {
  font-size: 20rpx;
  color: #8a867c;
  margin-top: 8rpx;
}

.profile-stats {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 0;
  box-shadow: 0 12rpx 28rpx rgba(63, 47, 38, .08);
  margin-bottom: 20rpx;
}

.profile-stats view {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #2f2a24;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: #8a867c;
  margin-top: 6rpx;
}

.club-profile-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 26rpx;
  box-shadow: 0 12rpx 28rpx rgba(63, 47, 38, .08);
}

.club-profile-section .section-title {
  font-size: 28rpx;
  font-weight: 850;
  color: #2f2a24;
  padding: 20rpx 0 8rpx;
}

.club-profile-section button {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  background: none;
  border: 0;
  border-top: 1rpx solid #f0e8da;
  padding: 26rpx 0;
  text-align: left;
}

.club-profile-section button text:first-child {
  flex: 1;
  font-size: 27rpx;
  font-weight: 700;
  color: #2f2a24;
}

.club-profile-section button text:nth-child(2) {
  font-size: 21rpx;
  color: #8a867c;
}

.row-arrow {
  color: #d97757;
  font-size: 28rpx;
}

.profile-edit::after,
.profile-promos button::after,
.club-profile-section button::after,
.explore-clear::after,
.explore-filters button::after {
  border: none;
}
