<view class="page">
  <view wx:if="{{view === 'intro'}}" class="intro-screen">
    <view class="intro-cup intro-cup-left"></view>
    <view class="intro-line"></view>
    <view class="intro-cup intro-cup-right"></view>
    <view class="intro-word">恰好</view>
  </view>

  <view wx:if="{{showAppHeader}}" class="app-header">
    <view wx:if="{{canGoBack}}" class="header-back" bindtap="back" aria-label="返回">
      <text class="header-back-icon">‹</text>
    </view>
    <view class="app-header-title">{{screenTitle}}</view>
    <view class="header-right"></view>
  </view>

  <view wx:if="{{view === 'welcome'}}" class="welcome-screen">
    <view class="cup-logo">
      <view class="lens left"></view>
      <view class="bridge"></view>
      <view class="lens right"></view>
    </view>
    <view class="welcome-brand">让恰好的关系</view>
    <view class="welcome-title">从见面开始</view>
    <button class="welcome-start" bindtap="go" data-view="introLetter">开始认识彼此</button>
  </view>

  <scroll-view wx:if="{{view === 'introLetter'}}" scroll-y class="screen letter-screen">
    <image class="letter-portrait" src="/pages/index/images/portrait-user.jpg" mode="aspectFit" />
    <view class="letter-head">
      <view class="letter-kicker">见字如面。</view>
      <view class="letter-body">我是90后的小CC，和此刻正在读这封信的你一样，也想在这个快节奏的城市里，认真寻找并建立一段长期而真实的亲密关系。</view>
      <view class="letter-body">我相信，所有恰好关系都是从见面开始的。所以我开设了针对不同情感需求场景的线下交友活动，想给你一个机会——<text class="letter-em">认真认识别人，也被认真认识。</text></view>
      <view class="letter-body">我做这个小程序，是想先更懂你们真正的交友需求，<text class="letter-em">再用恰好的方式，把你与恰好的人的见面方式精准推送到你面前</text>，少一点出门的犹豫，多一点线下相遇的可能——让可靠的关系，从一次真实的见面开始。</view>
      <view class="letter-sign">小CC</view>
    </view>
    <view class="letter-faith">
      <view class="letter-faith-title">恰好的信奉</view>
      <view class="faith-item">喜欢要从见面开始</view>
      <view class="faith-item">先立体识人，而后心生欢喜</view>
      <view class="faith-item">接住不同情感需求场景</view>
    </view>
    <button class="primary-btn wide letter-next" bindtap="go" data-view="lightQa">开始吧 →</button>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'auth'}}" scroll-y class="screen auth-screen">
    <view class="auth-hero">
      <view class="auth-kicker">先登录，再慢慢认识彼此</view>
      <view class="auth-title">你的体验会被好好保留下来</view>
      <text>登录后，你的回答、画像和活动记录会在下次回来时继续保留。</text>
    </view>
    <view class="auth-card">
      <view class="auth-account" wx:if="{{loggedIn}}">
        <view class="auth-avatar">Z</view>
        <view><text>欢迎回来，{{accountName}}</text><text>继续完成你的恰好画像</text></view>
      </view>
      <view class="auth-switch">
        <button class="{{authMode === 'wechat' ? 'active' : ''}}" data-mode="wechat" bindtap="switchAuthMode">微信快捷登录</button>
        <button class="{{authMode === 'phone' ? 'active' : ''}}" data-mode="phone" bindtap="switchAuthMode">手机号登录</button>
      </view>
      <block wx:if="{{authMode === 'wechat'}}">
        <view class="auth-privacy">微信登录仅用于识别你的账号，不会公开你的微信信息。</view>
        <button class="primary-btn wide auth-login-btn" bindtap="loginUser">{{loggedIn ? '继续进入恰好' : '微信快捷进入'}}</button>
      </block>
      <block wx:else>
        <input class="auth-input" type="number" value="{{phoneNumber}}" data-field="phoneNumber" bindinput="updateAuthField" cursor-spacing="20" maxlength="11" placeholder="手机号" />
        <input class="auth-input" type="number" value="{{verificationCode}}" data-field="verificationCode" bindinput="updateAuthField" cursor-spacing="20" maxlength="6" placeholder="验证码（体验阶段可填写任意6位）" />
        <button class="primary-btn wide auth-login-btn" bindtap="loginUser">登录并开始认识彼此</button>
      </block>
      <view class="auth-footnote">注册即代表你愿意遵守社区的真实、尊重与隐私约定</view>
    </view>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'wxTouch'}}" scroll-y class="screen">
    <view class="wechat-time">今天 19:36</view>
    <view class="wx-row">
      <view class="wx-avatar"></view>
      <view class="wx-bubble">你之前说「怕人多，也怕无效社交」。这周有一场6-8人轻聊天晚餐局，流程很清楚，在KIC附近。</view>
    </view>
    <button class="wx-card" bindtap="go" data-view="activityDetail">
      <view class="wx-cover">
        <view class="wx-title">周五轻聊天晚餐局</view>
        <view class="wx-sub">成熟活动 · 少人数 · 想认识靠谱的人</view>
      </view>
      <view class="wx-foot">点击查看是否适合你 <text>›</text></view>
    </button>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'lightQa'}}" scroll-y class="screen">
    <view class="qa-intro">
      <view class="qa-kicker">先问 6 个轻问题 · 约 1 分钟</view>
      <view class="qa-main-title">帮你挑一场阻力最小的见面</view>
    </view>
    <view class="entry-bar">
      <view class="entry-bar-fill" style="width: {{(entryIndex + 1) * 16.67}}%"></view>
    </view>
    <view class="question-card">
      <view class="entry-step">第 {{entryIndex + 1}} / {{entryQuestions.length}} 题</view>
      <view class="q-title">{{entryQuestions[entryIndex].title}}</view>
      <view class="entry-hint">{{entryQuestions[entryIndex].hint}}</view>
      <view class="option-grid">
        <button
          wx:for="{{entryQuestions[entryIndex].options}}"
          wx:key="index"
          class="option entry-full {{entryAnswers[entryQuestions[entryIndex].id][index] ? 'active' : ''}}"
          data-qid="{{entryQuestions[entryIndex].id}}"
          data-oi="{{index}}"
          bindtap="toggleEntryOption"
        >
          <text>{{item.text}}</text>
          <text wx:if="{{item.sub}}" class="option-sub">{{item.sub}}</text>
        </button>
      </view>
    </view>
    <view class="entry-foot">
      <button wx:if="{{entryIndex > 0}}" class="entry-prev" bindtap="entryPrev">‹ 上一题</button>
      <button class="primary-btn entry-next" bindtap="entryNext">{{entryIndex < entryQuestions.length - 1 ? '下一步' : '完成，去填关系里的你'}}</button>
    </view>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'deepQa'}}" scroll-y class="screen">
    <view class="qa-intro">
      <view class="qa-kicker">情感与交友 · 6 题</view>
      <view class="qa-main-title">再问你 6 个关于"你"的问题</view>
      <view class="qa-small">让初回画像更贴近真实的你。</view>
    </view>
    <view class="entry-bar">
      <view class="entry-bar-fill" style="width: {{(relIndex + 1) * 16.67}}%"></view>
    </view>
    <view class="question-card">
      <view class="entry-step">{{relQuestions[relIndex].dim}} · 第 {{relIndex + 1}} / {{relQuestions.length}} 题</view>
      <view class="q-title">{{relQuestions[relIndex].title}}</view>
      <view class="entry-hint">{{relQuestions[relIndex].hint}}</view>
      <view class="option-grid">
        <button
          wx:for="{{relQuestions[relIndex].options}}"
          wx:key="index"
          class="option entry-full {{relAnswers[relQuestions[relIndex].id][index] ? 'active' : ''}}"
          data-qid="{{relQuestions[relIndex].id}}"
          data-oi="{{index}}"
          bindtap="toggleRelOption"
        >
          <text>{{item.text}}</text>
        </button>
      </view>
    </view>
    <view class="entry-foot">
      <button wx:if="{{relIndex > 0}}" class="entry-prev" bindtap="relPrev">‹ 上一题</button>
      <button class="primary-btn entry-next" bindtap="relNext">{{relIndex < relQuestions.length - 1 ? '下一题' : '完成，去填基础资料'}}</button>
    </view>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'basicInfo'}}" scroll-y class="screen">
    <view class="avatar-center" bindtap="chooseAvatar">
      <view class="avatar-circle">
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" class="avatar-image" />
        <text wx:else>＋</text>
      </view>
      <view class="avatar-hint">{{avatarUrl ? '点击更换头像' : '点击上传头像（选填）'}}</view>
    </view>
    <view class="basic-info-card">
      <view class="soft-field full"><text>昵称<i>*</i></text><input value="{{basicInfo.name}}" data-field="name" bindinput="updateBasicField" cursor-spacing="20" placeholder="比如：小鱼" /></view>
      <view class="soft-field full">
        <text>性别<i>*</i></text>
        <picker mode="selector" range="{{genderOptions}}" data-field="gender" bindchange="updateBasicSelector">
          <view class="picker-value {{basicInfo.gender ? '' : 'placeholder'}}">{{basicInfo.gender || '选择性别'}}</view>
        </picker>
      </view>
      <view class="soft-field full">
        <text>生日<i>*</i></text>
        <picker mode="date" value="{{basicInfo.birth}}" start="1960-01-01" end="2008-12-31" bindchange="updateBasicDate">
          <view class="picker-value {{basicInfo.birth ? '' : 'placeholder'}}">{{basicInfo.birth || '选择年月日'}}</view>
        </picker>
      </view>
      <view class="soft-field full"><text>身高（选填）</text><input type="number" value="{{basicInfo.height}}" data-field="height" bindinput="updateBasicField" cursor-spacing="20" placeholder="cm，比如 168" /></view>
      <view class="soft-field full">
        <text>学历（选填）</text>
        <picker mode="selector" range="{{educationOptions}}" data-field="education" bindchange="updateBasicSelector">
          <view class="picker-value {{basicInfo.education ? '' : 'placeholder'}}">{{basicInfo.education || '选择学历'}}</view>
        </picker>
      </view>
      <view class="soft-field full">
        <text>家乡（选填）</text>
        <picker mode="region" value="{{basicInfo.hometownRegion}}" bindchange="updateHometownRegion">
          <view class="picker-value {{basicInfo.hometown ? '' : 'placeholder'}}">{{basicInfo.hometown || '选择省 / 市'}}</view>
        </picker>
      </view>
      <view class="soft-field full">
        <text>现居住地<i>*</i></text>
        <picker mode="region" value="{{basicInfo.region}}" bindchange="updateBasicRegion">
          <view class="picker-value {{basicInfo.area ? '' : 'placeholder'}}">{{basicInfo.area || '选择省 / 市 / 区'}}</view>
        </picker>
      </view>
      <view class="soft-field full"><text>职业（选填）</text><input value="{{basicInfo.occupation}}" data-field="occupation" bindinput="updateBasicField" cursor-spacing="20" placeholder="比如：设计师" /></view>
      <view class="soft-field full">
        <text>如果恰好这里是进入另一个你的平行宇宙的入口，你希望出现在一个什么样的场景里面，遇见谁？（选填）</text>
        <textarea class="scene-editor" value="{{basicInfo.scene}}" data-field="scene" bindinput="updateBasicField" cursor-spacing="20" maxlength="160" placeholder="或写下你自己的画面：场景 + 你想遇见谁。比如：在老家的稻田边躺着看云，遇见小时候的自己……" />
      </view>
    </view>
    <button class="primary-btn wide" bindtap="submitBasicInfo">生成我的初印象画像</button>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'profile'}}" scroll-y class="screen">
    <view class="mini-header">
      <view class="mini-title">这是你的初印象画像</view>
      <view class="mini-desc">先认识你一点点，画像会随使用慢慢生长，不用一次填完。</view>
    </view>
    <view class="profile-mini">
      <view class="profile-mini-cover">
        <view class="profile-mini-avatar">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" class="avatar-image" />
          <text wx:else>Z</text>
        </view>
        <view>
          <view class="profile-name">{{profileTitle}}</view>
          <view class="profile-sub">
            <text wx:if="{{basicInfo.gender}}" class="info-tag">{{basicInfo.gender}}</text>
            <text wx:if="{{basicInfo.area}}" class="info-tag">{{basicInfo.area}}</text>
          </view>
        </view>
      </view>
      <view class="profile-mini-body">
        <view class="profile-pill-row">
          <text wx:for="{{profileDims}}" wx:key="name" class="profile-pill">{{item.key}}</text>
        </view>
        <view class="profile-dims">
          <view wx:for="{{profileDims}}" wx:key="name" class="profile-dim">
            <view class="profile-dim-head">
              <text class="profile-dim-name">{{item.name}}</text>
              <text class="profile-dim-key">{{item.key}}</text>
            </view>
            <view class="profile-dim-tags">
              <text wx:for="{{item.tags}}" wx:key="*this" class="profile-dim-tag">{{item}}</text>
            </view>
          </view>
        </view>
        <view class="insight-card">{{profileInsight}}</view>
      </view>
    </view>
    <button class="primary-btn wide" bindtap="enterHome">进入恰好活动主页</button>
  </scroll-view>

      <scroll-view wx:elif="{{view === 'home'}}" scroll-y class="screen with-tab club-home">
    <view class="club-home-header">
      <view class="club-home-title">
        <text>恰好俱乐部</text>
        <view class="club-home-h1">恰好是你</view>
      </view>
      <view class="club-home-user">
        <image class="club-home-avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
        <image class="club-home-avatar" wx:else src="/pages/index/images/portrait-user.jpg" mode="aspectFill" />
        <text>{{basicInfo.name || '小恰'}}</text>
      </view>
    </view>

    <view class="portrait-strip">
      <image class="interactive-cat" src="/pages/index/images/posters/cat-stretch.png" mode="aspectFit" bindtap="tapCat" />
      <view class="portrait-strip-head">
        <text>刚刚懂你一点</text>
        <b>{{homeComplete}}%</b>
      </view>
      <view class="portrait-summary">{{homeSummary}}</view>
      <view class="portrait-hint">先看清自己的社交需求，再挑一场舒服的见面。</view>
      <view class="portrait-tags">
        <text wx:for="{{homeTags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="club-section">
      <view class="club-section-head">
        <view>
          <text>FOR YOU</text>
          <view class="club-section-title">给你的见面</view>
        </view>
      </view>
      <swiper class="home-swiper" previous-margin="56rpx" next-margin="56rpx" autoplay circular interval="4000" duration="400" bindchange="onSwiperChange">
        <swiper-item wx:for="{{homeCards}}" wx:key="id">
          <view class="poster-slide {{posterIndex === index ? 'active' : ''}}" data-id="{{item.id}}" bindtap="openActivity">
            <image class="poster-img" src="{{item.poster}}" mode="aspectFit" />
            <view class="poster-caption">
              <text class="poster-date">{{item.dateLabel}}</text>
              <text class="poster-title">{{item.title}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view wx:if="{{!needAsked}}" class="need-ask">
      <view class="need-ask-head">
        <image class="need-cat" src="/pages/index/images/posters/cat-stretch.png" mode="aspectFit" />
        <view>
          <view class="need-ask-name">{{basicInfo.name || '你'}}，问你一个真实的</view>
          <view class="need-ask-q">{{homeQuestion}}</view>
        </view>
      </view>
      <view class="need-opts">
        <button wx:for="{{homeQuestionOpts}}" wx:key="*this" class="need-opt {{myNeedSel === item ? 'active' : ''}}" data-val="{{item}}" bindtap="toggleNeedOption">{{item}}</button>
      </view>
      <input class="need-other" value="{{myNeedOther}}" data-field="myNeedOther" bindinput="updateNeedOther" cursor-spacing="20" placeholder="其他，写下来（比如：周末下午，有人一起逛公园）" />
      <button class="primary-btn wide" bindtap="submitHomeNeed">告诉小CC</button>
    </view>

    <view wx:else class="need-recommend voice">
      <view class="voice-top">
        <image class="voice-cat" src="/pages/index/images/posters/cat-stretch.png" mode="aspectFit" />
        <view>
          <view class="voice-label">你的声音</view>
          <view class="voice-q">小CC问你："{{myNeedQuestion}}"</view>
          <view class="voice-a">你回答：{{myNeed}}</view>
        </view>
      </view>
      <view class="voice-echo">还有 6 人和你一样，小CC正在为你找。</view>
      <view class="voice-actions">
        <button class="voice-btn ghost" bindtap="editMyNeed">补充一下</button>
        <button class="voice-btn main" bindtap="go" data-view="square">去需求广场看看</button>
      </view>
    </view>
    <view class="home-end-space"></view>
  </scroll-view>


    <view wx:elif="{{view === 'activityDetail'}}" class="detail-page">
    <scroll-view scroll-y class="detail-scroll">
      <view class="poster-wrap">
        <image wx:if="{{activeActivity.poster}}" class="detail-poster" src="{{activeActivity.poster}}" mode="aspectFit" />
        <view wx:else class="detail-poster-fallback {{activeActivity.coverClass}}">{{activeActivity.coverText}}</view>
        <button class="share-chip" open-type="share">分享海报＋信息</button>
      </view>

      <view class="info-card">
        <view class="info-title">{{activeActivity.title}}</view>
        <view class="info-sub">{{activeActivity.subtitle}}</view>
        <view class="facts">
          <view class="fact"><text class="fact-label">时间</text><text class="fact-value">{{activeActivity.date}} {{activeActivity.weekday}}</text><text class="fact-sub">{{activeActivity.time}}</text></view>
          <view class="fact"><text class="fact-label">地点</text><text class="fact-value">{{activeActivity.location}}</text></view>
          <view class="fact"><text class="fact-label">人数</text><text class="fact-value">{{activeActivity.people}}</text></view>
          <view class="fact"><text class="fact-label">费用</text><text class="fact-value">{{activeActivity.fee}}</text></view>
        </view>
      </view>

      <view class="block">
        <view class="block-title">适合谁</view>
        <view class="block-body">{{activeActivity.crowd}}<text class="block-note">不换简历、不点名配对，你可以只来听，也可以慢慢开口。</text></view>
      </view>

      <view class="block cc">
        <view class="block-title">小CC的话</view>
        <view class="block-body">{{matchReason}}</view>
      </view>

      <view wx:if="{{activeActivity.schedule && activeActivity.schedule.length}}" class="block">
        <view class="block-title">活动流程 <text class="block-title-note">每个环节都是低压力设计</text></view>
        <view class="schedule">
          <view wx:for="{{activeActivity.schedule}}" wx:key="time" class="step">
            <view class="dot"></view>
            <text class="step-time">{{item.time}}</text>
            <text class="step-text">{{item.title}}</text>
          </view>
        </view>
      </view>

      <view class="block">
        <view class="block-title">安全提醒</view>
        <view class="block-body safety">第一次线下见面，请优先选择公共场所，并将行程告诉一位信任的朋友。</view>
      </view>

      <view wx:if="{{afterPartySpots.length}}" class="block">
        <view class="block-title">听你们的 <text class="block-title-note">散场后，还想一起去哪？</text></view>
        <view class="after-note">按你今晚的状态和散场时间挑的，都在 KIC 步行 10 分钟内。</view>
        <view wx:for="{{afterPartySpots}}" wx:key="id" class="after-spot">
          <view class="after-spot-head">
            <text class="after-cat">{{item.cat}}</text>
            <text class="after-name">{{item.name}}</text>
            <text class="after-walk">{{item.walk}}</text>
          </view>
          <view class="after-why">{{item.why}}</view>
          <view class="after-tags">
            <text wx:for="{{item.vibe}}" wx:for-item="v" wx:key="*this" class="after-tag">{{v}}</text>
            <text wx:if="{{item.open}}" class="after-tag after-open">{{item.open}}</text>
            <text wx:if="{{item.perk}}" class="after-perk">{{item.perk}}</text>
          </view>
        </view>
        <view class="after-actions">
          <button class="after-btn line" bindtap="refreshAfterParty">换一批</button>
          <button class="after-btn solid" bindtap="shareAfterParty">发到活动群</button>
        </view>
        <view class="after-foot">去不去都行，先去也是好的。报名后，就能把这三个去处发到活动群。</view>
      </view>

      <view class="detail-links">
        <button class="detail-link" bindtap="openActivityGroup">{{activityGroupJoined ? '已加入活动群' : '活动群聊'}}</button>
        <button class="detail-link warn" data-id="{{activeActivity.id}}" bindtap="dismissCard">不喜欢这类</button>
      </view>
    </scroll-view>

    <view class="detail-bar">
      <button class="bar-btn main" bindtap="registerActivity">{{activeActivityRegistered ? '已报名，等待活动确认' : '立即报名'}}</button>
      <button class="bar-btn ghost" bindtap="openReason">考虑一下</button>
    </view>
  </view>

    <scroll-view wx:elif="{{view === 'explore'}}" scroll-y class="screen with-tab explore-page">
    <view class="explore-hero">
      <view class="explore-hero-title">发现其他活动</view>
      <view class="explore-hero-desc">按出门阻力和见面方式，挑一场刚刚好的局。</view>
    </view>
    <view class="explore-search">
      <input class="explore-input" value="{{exploreSearch}}" bindinput="updateExploreSearch" cursor-spacing="20" placeholder="搜索活动、地点或场景" />
    </view>
    <scroll-view scroll-x class="explore-filters">
      <button class="{{exploreFilter === 'all' ? 'is-active' : ''}}" data-filter="all" bindtap="setExploreFilter">全部</button>
      <button class="{{exploreFilter === 'low' ? 'is-active' : ''}}" data-filter="low" bindtap="setExploreFilter">低压力</button>
      <button class="{{exploreFilter === 'deep' ? 'is-active' : ''}}" data-filter="deep" bindtap="setExploreFilter">深聊</button>
      <button class="{{exploreFilter === 'walk' ? 'is-active' : ''}}" data-filter="walk" bindtap="setExploreFilter">散步</button>
      <button class="{{exploreFilter === 'workshop' ? 'is-active' : ''}}" data-filter="workshop" bindtap="setExploreFilter">工作坊</button>
      <button class="{{exploreFilter === 'lunch' ? 'is-active' : ''}}" data-filter="lunch" bindtap="setExploreFilter">午间</button>
    </scroll-view>
    <scroll-view scroll-x class="explore-filters distance">
      <button class="{{exploreDist === 'all' ? 'is-active' : ''}}" data-filter="all" bindtap="setExploreDist">全部距离</button>
      <button class="{{exploreDist === 'near' ? 'is-active' : ''}}" data-filter="near" bindtap="setExploreDist">3km内</button>
      <button class="{{exploreDist === 'middle' ? 'is-active' : ''}}" data-filter="middle" bindtap="setExploreDist">5km内</button>
      <button class="{{exploreDist === 'sameCity' ? 'is-active' : ''}}" data-filter="sameCity" bindtap="setExploreDist">同城可达</button>
    </scroll-view>
    <view class="explore-list">
      <view wx:for="{{exploreList}}" wx:key="id" class="explore-card" data-id="{{item.id}}" bindtap="openActivity">
        <image class="explore-poster" src="{{item.poster}}" mode="aspectFill" />
        <view class="explore-info">
          <text class="explore-date">{{item.date}} {{item.weekday}} {{item.time}}</text>
          <text class="explore-title">{{item.title}}</text>
          <text class="explore-loc">{{item.location}} · {{item.people}}</text>
          <view class="explore-tags">
            <text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{!exploreList.length}}" class="explore-empty">
      <view class="explore-empty-title">没有找到合适活动</view>
      <button class="explore-clear" bindtap="clearExploreFilter">清除筛选</button>
    </view>
  </scroll-view>

    <scroll-view wx:elif="{{view === 'square'}}" scroll-y class="screen with-tab needs-page">
    <view class="needs-hero">
      <text>需求广场</text>
      <view class="needs-hero-title">先被看见，再慢慢靠近</view>
      <view class="needs-hero-desc">需求，是你想遇见谁。说出你的关系所想，被同频的人接住。</view>
    </view>

    <block>
      <view class="needs-sort">
        <button class="{{needSort === 'latest' ? 'on' : ''}}" data-sort="latest" bindtap="switchNeedSort">最新</button>
        <button class="{{needSort === 'hot' ? 'on' : ''}}" data-sort="hot" bindtap="switchNeedSort">最共鸣</button>
      </view>
      <scroll-view scroll-x class="needs-hlist">
        <view wx:for="{{displayedNeeds}}" wx:key="id" class="need-card-large">
          <view class="need-card-media" data-id="{{item.id}}" bindtap="openDemandDetail">
            <image wx:if="{{item.image}}" class="need-media-img" src="{{item.image}}" mode="aspectFit" />
            <text class="need-media-sub">{{item.subtitle}}</text>
          </view>
          <view class="need-card-content">
            <text class="need-author">{{item.author}}</text>
            <view class="need-card-title" data-id="{{item.id}}" bindtap="openDemandDetail"><text>{{item.title}}</text></view>
            <text class="need-copy">{{item.copy}}</text>
            <view class="club-tags">
              <text wx:for="{{item.tags}}" wx:key="*this" class="need-tag">{{item}}</text>
            </view>
            <view class="need-card-actions">
              <button class="{{resonatedNeedIds[item.id] ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="toggleNeedResonance">{{resonatedNeedIds[item.id] ? '已共鸣' : '我也有'}} {{item.resonance + (resonatedNeedIds[item.id] ? 1 : 0)}}</button>
              <button data-id="{{item.id}}" bindtap="openDemandDetail">评论 {{item.commentsCount}}</button>
              <button class="{{savedNeedIds[item.id] ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="toggleNeedSave">{{savedNeedIds[item.id] ? '已收藏' : '收藏'}}</button>
            </view>
          </view>
        </view>
      </scroll-view>
    </block>

    <view class="need-fab" bindtap="openNeedComposer" hover-class="need-fab-hover"><text class="need-fab-plus">+</text></view>
    <view wx:if="{{showNeedComposer}}" class="need-composer-mask" bindtap="cancelNeedComposer">
      <view class="need-composer-sheet" style="bottom: {{needKeyboardHeight}}px" catchtap="noop">
        <view class="need-sheet-head">
          <text>发布你的需求卡</text>
          <button class="need-sheet-close" bindtap="cancelNeedComposer">关闭</button>
        </view>
        <scroll-view scroll-y class="need-sheet-body">
          <view class="card-text">写一句话，点几个心动碎片，恰好会更懂你。</view>
          <view class="need-openers">
            <button wx:for="{{needOpeners}}" wx:key="*this" class="need-opener" data-opener="{{item}}" bindtap="tapNeedOpener">{{item}}</button>
          </view>
          <textarea class="need-publish-editor" value="{{myNeedDraft}}" bindinput="updateNeedDraft" bindkeyboardheightchange="onNeedKeyboardChange" cursor-spacing="24" adjust-position="{{false}}" maxlength="60" placeholder="想遇见＿＿，一起＿＿" />
          <view class="need-frag-label">心动碎片（可选）</view>
          <view class="need-frag-row">
            <button wx:for="{{needFragScene}}" wx:key="*this" class="need-frag {{selectedNeedFragMap[item] ? 'on' : ''}}" data-frag="{{item}}" bindtap="toggleNeedFrag">{{item}}</button>
          </view>
          <view class="need-frag-row">
            <button wx:for="{{needFragRelation}}" wx:key="*this" class="need-frag {{selectedNeedFragMap[item] ? 'on' : ''}}" data-frag="{{item}}" bindtap="toggleNeedFrag">{{item}}</button>
          </view>
          <view class="need-frag-label">封面（可选）</view>
          <view class="need-cover-preview">
            <image wx:if="{{needCoverPreview}}" class="need-cover-preview-img" src="{{needCoverPreview}}" mode="aspectFit" />
            <view wx:else class="need-cover-empty">让恰好生成一张，或从相册上传</view>
            <text wx:if="{{needCoverName}}" class="need-cover-preview-name">{{needCoverName}}</text>
          </view>
          <view class="need-cover-actions">
            <button class="need-cover-act" bindtap="aiGenerateCover">{{needCoverPreview ? '换一张' : '让恰好生成'}}</button>
            <button class="need-cover-act upload" bindtap="uploadCover">＋ 上传照片</button>
          </view>
        </scroll-view>
      </view>
      <view class="need-sheet-foot" style="bottom: {{needKeyboardHeight}}px" catchtap="noop">
        <button class="ghost-btn" bindtap="cancelNeedComposer">取消</button>
        <button class="primary-btn" bindtap="publishNeed">发布需求卡</button>
      </view>
    </view>
  </scroll-view>

    <scroll-view wx:elif="{{view === 'mine'}}" scroll-y class="screen with-tab club-profile">
    <view class="profile-cover"></view>
    <view class="profile-identity">
      <image class="profile-avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
      <image class="profile-avatar" wx:else src="/pages/index/images/portrait-user.jpg" mode="aspectFill" />
      <view class="profile-idtext">
        <view class="profile-name">{{basicInfo.name || '小恰'}}</view>
        <view class="profile-type">{{homeSummary || '低压力线下重启型'}}</view>
      </view>
      <button class="profile-edit" bindtap="editProfile">编辑</button>
    </view>
    <view class="trust-strip"><text>已实名</text><text>信用良好</text></view>
    <view class="portrait-progress">
      <view class="pp-head"><text>画像完善度</text><text>{{homeComplete}}%</text></view>
      <view class="pp-track"><view class="pp-fill" style="width: {{homeComplete}}%"></view></view>
      <view class="pp-hint">每次回答和活动反馈，都会让推荐更贴合你。</view>
    </view>
    <view class="profile-promos">
      <button bindtap="go" data-view="profile"><text class="promo-title">画像成长</text><text class="promo-sub">继续认识自己</text></button>
      <button class="orange" bindtap="go" data-view="savedNeeds"><text class="promo-title">需求收藏</text><text class="promo-sub">查看收藏的需求</text></button>
    </view>
    <view class="profile-stats">
      <view><text class="stat-num">{{registeredActivities.length}}</text><text class="stat-label">参与活动</text></view>
      <view><text class="stat-num">{{demandHistory.length}}</text><text class="stat-label">公开需求</text></view>
      <view><text class="stat-num">{{savedNeedCount}}</text><text class="stat-label">需求收藏</text></view>
    </view>
    <view class="club-profile-section">
      <view class="section-title">我的记录</view>
      <button bindtap="go" data-view="profile"><text>我的画像</text><text>根据回答和活动反馈持续更新</text><text class="row-arrow">›</text></button>
      <button bindtap="mineToast" data-text="参加过活动的记录会出现在这里"><text>参加过活动</text><text>{{registeredActivities.length}} 场</text><text class="row-arrow">›</text></button>
      <button bindtap="mineToast" data-text="收藏的活动会出现在这里"><text>活动收藏</text><text>{{savedActivityCount}} 个</text><text class="row-arrow">›</text></button>
      <button bindtap="go" data-view="square"><text>我的需求</text><text>{{myNeedCount}} 张需求卡</text><text class="row-arrow">›</text></button>
    </view>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'savedNeeds'}}" scroll-y class="screen with-tab saved-needs-page">
    <view class="subpage-header">
      <button class="subpage-back" bindtap="back">‹</button>
      <text>我收藏的需求</text>
    </view>
    <view wx:if="{{!savedNeedsList.length}}" class="saved-empty">
      <text>还没有收藏的需求</text>
      <button class="ghost-btn wide" bindtap="go" data-view="square">去需求广场看看</button>
    </view>
    <view wx:for="{{savedNeedsList}}" wx:key="id" class="saved-card" data-id="{{item.id}}" bindtap="openDemandDetail">
      <image wx:if="{{item.image}}" class="saved-card-img" src="{{item.image}}" mode="aspectFill" />
      <view class="saved-card-body">
        <view class="saved-card-title">{{item.title}}</view>
        <view class="saved-card-copy">{{item.copy}}</view>
        <view class="club-tags">
          <text wx:for="{{item.tags}}" wx:key="*this" class="need-tag">{{item}}</text>
        </view>
        <view class="saved-card-foot">{{item.resonance + (resonatedNeedIds[item.id] ? 1 : 0)}} 人共鸣 · {{item.commentsCount}} 条评论</view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{showDemandDetail}}" class="need-detail-page">
    <scroll-view scroll-y class="need-detail-scroll">
      <view class="need-detail-media">
        <image wx:if="{{activeDemand.image}}" class="need-detail-media-img" src="{{activeDemand.image}}" mode="aspectFill" />
        <view wx:else class="need-detail-media-fallback"></view>
        <button class="need-detail-back" bindtap="closeDemandDetail">‹</button>
      </view>
      <view class="need-detail-content">
        <small>{{activeDemand.author}} · {{activeDemand.subtitle || 'TA 在恰好说出自己的需求'}}</small>
        <view wx:if="{{activeDemand.question}}" class="need-detail-question">小CC问：{{activeDemand.question}}</view>
        <view class="need-detail-title">{{activeDemand.title}}</view>
        <view class="need-detail-copy">{{activeDemand.answer || activeDemand.detail || activeDemand.copy}}</view>
        <view class="club-tags need-detail-tags">
          <text wx:for="{{activeDemand.tags}}" wx:key="*this" class="need-tag">{{item}}</text>
        </view>
        <view class="need-detail-response">
          <view class="need-detail-response-head">
            <view class="need-detail-response-title">这张需求正在发生什么</view>
            <text class="{{activeDemand.response ? 'is-active' : 'is-waiting'}}">{{activeDemand.response ? '有人接住' : '还在等回应'}}</text>
          </view>
          <view class="need-detail-response-stats">
            <view><b>{{activeDemand.resonance + (resonatedNeedIds[activeDemand.id] ? 1 : 0)}}</b><small>人共鸣</small></view>
            <view><b>{{activeDemand.commentsCount}}</b><small>条评论</small></view>
            <view><b>{{activeDemand.response ? 1 : 0}}</b><small>场回应</small></view>
          </view>
          <view wx:if="{{activeDemand.response}}" class="need-detail-response-link">
            <text>有活动回应了 · {{activeDemand.response}}</text>
          </view>
          <view wx:else class="need-detail-empty">
            <text class="need-detail-empty-title">还没有活动回应</text>
            <text class="need-detail-empty-desc">收藏这张需求，之后有合适的活动，我们会通知你</text>
          </view>
        </view>
        <view class="need-detail-comments">
          <view class="need-detail-comments-head">
            <view class="need-detail-comments-title">大家怎么说</view>
            <text>{{activeDemand.commentsCount}} 条</text>
          </view>
          <view wx:if="{{!activeDemand.comments.length}}" class="need-detail-comments-empty">还没有人说话，你来当第一个</view>
          <view wx:for="{{activeDemand.comments}}" wx:key="*this" class="need-detail-comment">
            <view class="comment-avatar">Z</view>
            <view class="need-detail-comment-body">
              <view class="comment-name">恰好用户</view>
              <view>{{item}}</view>
            </view>
          </view>
          <view class="need-detail-composer">
            <textarea class="demand-editor" value="{{demandComment}}" bindinput="updateDemandComment" bindkeyboardheightchange="onDemandKeyboardChange" cursor-spacing="24" maxlength="300" placeholder="说点什么…" />
            <button class="tiny-btn primary" bindtap="addDemandComment">发布</button>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="need-detail-actions" style="bottom: {{demandKeyboardHeight}}px">
      <button class="{{resonatedNeedIds[activeDemand.id] ? 'is-active' : ''}}" data-id="{{activeDemand.id}}" bindtap="toggleNeedResonance">{{resonatedNeedIds[activeDemand.id] ? '已共鸣' : '我也有'}} {{activeDemand.resonance + (resonatedNeedIds[activeDemand.id] ? 1 : 0)}}</button>
      <button class="{{savedNeedIds[activeDemand.id] ? 'is-active' : ''}}" data-id="{{activeDemand.id}}" bindtap="toggleNeedSave">{{savedNeedIds[activeDemand.id] ? '已收藏' : '收藏'}}</button>
    </view>
  </view>

  <view wx:if="{{showTab}}" class="tab-bar">
    <button class="tab-item {{view === 'home' ? 'active' : ''}}" bindtap="go" data-view="home">专属</button>
    <button class="tab-item {{view === 'explore' ? 'active' : ''}}" bindtap="go" data-view="explore">发现</button>
    <button class="tab-item {{view === 'square' ? 'active' : ''}}" bindtap="go" data-view="square">需求</button>
    <button class="tab-item {{view === 'mine' ? 'active' : ''}}" bindtap="go" data-view="mine">我的</button>
  </view>

  <view wx:if="{{showReasonModal}}" class="modal-mask" bindtap="closeReason">
    <view class="reason-modal" catchtap="noop">
      <view class="modal-title">你为什么还想考虑？</view>
      <view class="modal-desc">你的选择会让推荐更准确</view>
      <button wx:for="{{reasonOptions}}" wx:key="*this" class="reason" data-reason="{{item}}" bindtap="closeReason">{{item}}</button>
      <button class="ghost-btn wide" bindtap="closeReason" data-reason="已收藏">先收藏</button>
    </view>
  </view>
</view>
