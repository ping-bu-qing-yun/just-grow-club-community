<view class="page">
  <view wx:if="{{view === 'intro'}}" class="intro-screen">
    <view class="intro-cup intro-cup-left"></view>
    <view class="intro-line"></view>
    <view class="intro-cup intro-cup-right"></view>
    <view class="intro-word">恰好</view>
    <button class="intro-skip" bindtap="skipIntro">轻触进入恰好</button>
  </view>

  <view wx:if="{{showAppHeader}}" class="app-header">
    <view wx:if="{{canGoBack}}" class="header-back" bindtap="back" aria-label="返回">
      <text class="header-back-icon">‹</text>
    </view>
    <view class="app-header-title">{{screenTitle}}</view>
    <view class="header-right"></view>
  </view>

  <view wx:if="{{view === 'welcome'}}" class="welcome-screen">
    <view class="cup-logo">
      <view class="lens left"></view>
      <view class="bridge"></view>
      <view class="lens right"></view>
    </view>
    <view class="welcome-brand">认真认识一个人</view>
    <view class="welcome-title">从真实见面开始</view>
    <button class="welcome-start" bindtap="go" data-view="introLetter">开始认识彼此</button>
  </view>

  <scroll-view wx:if="{{view === 'introLetter'}}" scroll-y class="screen letter-screen">
    <image class="letter-portrait" src="/pages/index/images/portrait-user.jpg" mode="aspectFit" />
    <view class="letter-head">
      <view class="letter-kicker">你好，我是小CC。</view>
      <view class="letter-body">恰好不做快速筛选，也不催你立刻交换联系方式。我们想让你在真实见面里，慢慢看见一个人，也让自己被认真看见。</view>
      <view class="letter-body">先说清自己的需要、边界和靠近方式，再参加适合的小型活动。关系不是等来的答案，而是一次次真实表达、倾听和选择。</view>
      <view class="letter-sign">小CC</view>
    </view>
    <button class="primary-btn wide letter-next" bindtap="go" data-view="auth">继续</button>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'auth'}}" scroll-y class="screen auth-screen">
    <view class="auth-hero">
      <view class="auth-kicker">保存你的进度</view>
      <view class="auth-title">用微信登录恰好</view>
      <text>回答、画像和报名意向会安全保存，换设备也能继续。</text>
    </view>
    <view class="auth-card">
      <view class="auth-account" wx:if="{{loggedIn}}">
        <view class="auth-avatar">Z</view>
        <view><text>欢迎回来，{{accountName}}</text><text>继续完成你的恰好画像</text></view>
      </view>
      <view class="auth-privacy">资料默认不公开，只用于本人画像和活动推荐。</view>
      <button class="primary-btn wide auth-login-btn" bindtap="loginUser">{{loggedIn ? '继续' : '微信登录'}}</button>
      <view class="auth-footnote">请真实表达，也尊重每个人的选择和边界。</view>
    </view>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'lightQa'}}" scroll-y class="screen">
    <view class="qa-intro">
      <view class="qa-kicker">6 个选择 · 约 1 分钟</view>
      <view class="qa-main-title">先找到你愿意参加的见面</view>
    </view>
    <view class="entry-bar">
      <view class="entry-bar-fill" style="width: {{(entryIndex + 1) * 16.67}}%"></view>
    </view>
    <view class="question-card">
      <view class="entry-step">第 {{entryIndex + 1}} / {{entryQuestions.length}} 题</view>
      <view class="q-title">{{entryQuestions[entryIndex].title}}</view>
      <view class="entry-hint">{{entryQuestions[entryIndex].hint}}</view>
      <view class="option-grid">
        <button
          wx:for="{{entryQuestions[entryIndex].options}}"
          wx:key="index"
          class="option entry-full {{entryAnswers[entryQuestions[entryIndex].id][index] ? 'active' : ''}}"
          data-qid="{{entryQuestions[entryIndex].id}}"
          data-oi="{{index}}"
          bindtap="toggleEntryOption"
        >
          <text>{{item.text}}</text>
          <text wx:if="{{item.sub}}" class="option-sub">{{item.sub}}</text>
        </button>
      </view>
    </view>
    <view class="entry-foot">
      <button wx:if="{{entryIndex > 0}}" class="entry-prev" bindtap="entryPrev">‹ 上一题</button>
      <button class="primary-btn entry-next" bindtap="entryNext">{{entryIndex < entryQuestions.length - 1 ? '下一步' : '完成，去填关系里的你'}}</button>
    </view>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'deepQa'}}" scroll-y class="screen">
    <view class="qa-intro">
      <view class="qa-kicker">关系实践 · 6 题</view>
      <view class="qa-main-title">你如何靠近、表达与守住边界</view>
    </view>
    <view class="entry-bar">
      <view class="entry-bar-fill" style="width: {{(relIndex + 1) * 16.67}}%"></view>
    </view>
    <view class="question-card">
      <view class="entry-step">{{relQuestions[relIndex].dim}} · 第 {{relIndex + 1}} / {{relQuestions.length}} 题</view>
      <view class="q-title">{{relQuestions[relIndex].title}}</view>
      <view class="entry-hint">{{relQuestions[relIndex].hint}}</view>
      <view class="option-grid">
        <button
          wx:for="{{relQuestions[relIndex].options}}"
          wx:key="index"
          class="option entry-full {{relAnswers[relQuestions[relIndex].id][index] ? 'active' : ''}}"
          data-qid="{{relQuestions[relIndex].id}}"
          data-oi="{{index}}"
          bindtap="toggleRelOption"
        >
          <text>{{item.text}}</text>
        </button>
      </view>
    </view>
    <view class="entry-foot">
      <button wx:if="{{relIndex > 0}}" class="entry-prev" bindtap="relPrev">‹ 上一题</button>
      <button class="primary-btn entry-next" bindtap="relNext">{{relIndex < relQuestions.length - 1 ? '下一题' : '完成，去填基础资料'}}</button>
    </view>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'basicInfo'}}" scroll-y class="screen">
    <button class="avatar-center" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <view class="avatar-circle">
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" class="avatar-image" />
        <text wx:else>＋</text>
      </view>
      <view class="avatar-hint">{{avatarUrl ? '点击更换头像' : '选择微信头像（选填）'}}</view>
    </button>
    <view class="basic-info-card">
      <view class="soft-field full"><text>昵称<i>*</i></text><input type="nickname" value="{{basicInfo.name}}" data-field="name" bindinput="updateBasicField" cursor-spacing="20" placeholder="比如：小鱼" /></view>
      <view class="soft-field full">
        <text>性别<i>*</i></text>
        <picker mode="selector" range="{{genderOptions}}" data-field="gender" bindchange="updateBasicSelector">
          <view class="picker-value {{basicInfo.gender ? '' : 'placeholder'}}">{{basicInfo.gender || '选择性别'}}</view>
        </picker>
      </view>
      <view class="soft-field full">
        <text>生日<i>*</i></text>
        <picker mode="date" value="{{basicInfo.birth}}" start="1960-01-01" end="2008-12-31" bindchange="updateBasicDate">
          <view class="picker-value {{basicInfo.birth ? '' : 'placeholder'}}">{{basicInfo.birth || '选择年月日'}}</view>
        </picker>
      </view>
      <view class="soft-field full"><text>身高（选填）</text><input type="number" value="{{basicInfo.height}}" data-field="height" bindinput="updateBasicField" cursor-spacing="20" placeholder="cm，比如 168" /></view>
      <view class="soft-field full">
        <text>学历（选填）</text>
        <picker mode="selector" range="{{educationOptions}}" data-field="education" bindchange="updateBasicSelector">
          <view class="picker-value {{basicInfo.education ? '' : 'placeholder'}}">{{basicInfo.education || '选择学历'}}</view>
        </picker>
      </view>
      <view class="soft-field full">
        <text>家乡（选填）</text>
        <picker mode="region" value="{{basicInfo.hometownRegion}}" bindchange="updateHometownRegion">
          <view class="picker-value {{basicInfo.hometown ? '' : 'placeholder'}}">{{basicInfo.hometown || '选择省 / 市'}}</view>
        </picker>
      </view>
      <view class="soft-field full">
        <text>现居住地<i>*</i></text>
        <picker mode="region" value="{{basicInfo.region}}" bindchange="updateBasicRegion">
          <view class="picker-value {{basicInfo.area ? '' : 'placeholder'}}">{{basicInfo.area || '选择省 / 市 / 区'}}</view>
        </picker>
      </view>
      <view class="soft-field full"><text>职业（选填）</text><input value="{{basicInfo.occupation}}" data-field="occupation" bindinput="updateBasicField" cursor-spacing="20" placeholder="比如：设计师" /></view>
      <view class="soft-field full">
        <text>你想在怎样的场景里，认真认识怎样的人？（选填）</text>
        <textarea class="scene-editor" value="{{basicInfo.scene}}" data-field="scene" bindinput="updateBasicField" cursor-spacing="20" maxlength="160" placeholder="比如：一起散步，能自然聊到生活和关系。" />
      </view>
    </view>
    <button class="primary-btn wide" bindtap="submitBasicInfo">生成我的初印象画像</button>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'profile'}}" scroll-y class="screen">
    <view class="mini-header">
      <view class="mini-title">这是你的初印象画像</view>
      <view class="mini-desc">这是初步理解，不是标签。它会随着回答和真实见面继续更新。</view>
    </view>
    <view class="profile-mini">
      <view class="profile-mini-cover">
        <view class="profile-mini-avatar">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" class="avatar-image" />
          <text wx:else>Z</text>
        </view>
        <view>
          <view class="profile-name">{{profileTitle}}</view>
          <view class="profile-sub">
            <text wx:if="{{basicInfo.gender}}" class="info-tag">{{basicInfo.gender}}</text>
            <text wx:if="{{basicInfo.area}}" class="info-tag">{{basicInfo.area}}</text>
          </view>
        </view>
      </view>
      <view class="profile-mini-body">
        <view class="profile-pill-row">
          <text wx:for="{{profileDims}}" wx:key="name" class="profile-pill">{{item.key}}</text>
        </view>
        <view class="profile-dims">
          <view wx:for="{{profileDims}}" wx:key="name" class="profile-dim">
            <view class="profile-dim-head">
              <text class="profile-dim-name">{{item.name}}</text>
              <text class="profile-dim-key">{{item.key}}</text>
            </view>
            <view class="profile-dim-tags">
              <text wx:for="{{item.tags}}" wx:key="*this" class="profile-dim-tag">{{item}}</text>
            </view>
          </view>
        </view>
        <view class="insight-card">{{profileInsight}}</view>
      </view>
    </view>
    <button class="primary-btn wide" bindtap="enterHome">进入恰好活动主页</button>
  </scroll-view>

      <scroll-view wx:elif="{{view === 'home'}}" scroll-y class="screen with-tab club-home">
    <view class="club-home-header">
      <view class="club-home-title">
        <text>恰好俱乐部</text>
        <view class="club-home-h1">恰好是你</view>
      </view>
      <view class="club-home-user">
        <image class="club-home-avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
        <image class="club-home-avatar" wx:else src="/pages/index/images/portrait-user.jpg" mode="aspectFill" />
        <text>{{basicInfo.name || '小恰'}}</text>
      </view>
    </view>

    <view class="portrait-strip">
      <image class="interactive-cat" src="/pages/index/images/posters/cat-stretch.png" mode="aspectFit" bindtap="tapCat" />
      <view class="portrait-strip-head">
        <text>先懂你一点</text>
      </view>
      <view class="portrait-summary">{{homeSummary}}</view>
      <view class="portrait-hint">看清自己的需要，再选择愿意实践的见面。</view>
      <view class="portrait-tags">
        <text wx:for="{{homeTags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="club-section">
      <view class="club-section-head">
        <view>
          <text>FOR YOU</text>
          <view class="club-section-title">给你的见面</view>
        </view>
      </view>
      <swiper class="home-swiper" previous-margin="56rpx" next-margin="56rpx" autoplay circular interval="4000" duration="400" bindchange="onSwiperChange">
        <swiper-item wx:for="{{homeCards}}" wx:key="id">
          <view class="poster-slide {{posterIndex === index ? 'active' : ''}}" data-id="{{item.id}}" bindtap="openActivity">
            <image class="poster-img" src="{{item.poster}}" mode="aspectFit" />
            <view class="poster-caption">
              <text class="poster-date">{{item.dateLabel}}</text>
              <text class="poster-title">{{item.title}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view class="home-letter" wx:if="{{letterMode !== 'done'}}">
      <view class="letter-envelope">
        <view class="letter-kicker">
          <text class="letter-dot" style="background: {{letterTopic.color}}"></text>
          <text>{{letterMode === 'free' ? '你自己发起的话题' : letterTopic.cat}}</text>
          <text class="letter-seal">见字如面</text>
        </view>
        <image class="letter-cat" src="/pages/index/images/posters/cat-stretch.png" mode="aspectFit" />
        <view class="letter-head">小CC的来信</view>
        <view wx:if="{{letterMode === 'ask'}}" class="letter-q">{{letterTopic.q}}</view>
        <input wx:else class="letter-topic-input" value="{{letterMyTopic}}" bindinput="updateLetterMyTopic" cursor-spacing="20" maxlength="30" placeholder="写下你想聊的话题" />
        <textarea class="letter-answer" value="{{letterDraft}}" bindinput="updateLetterDraft" cursor-spacing="20" maxlength="200" placeholder="{{letterMode === 'free' ? '围绕你自己的话题，说几句真实感受…' : '回信给小CC，写几句此刻的真实感受…'}}" />
        <view class="letter-count">{{letterDraft.length}}/200</view>
        <view class="letter-actions">
          <button class="letter-btn ghost" bindtap="toggleLetterSource">{{letterMode === 'ask' ? '我也有个话题' : '回到小CC的来信'}}</button>
          <button class="letter-btn main" bindtap="submitHomeLetter">{{letterMode === 'free' ? '把话题交给小CC' : '把回信交给小CC'}}</button>
        </view>
        <view wx:if="{{letterMode === 'ask'}}" class="letter-switch" bindtap="switchHomeLetter">换一个话题 ↻</view>
      </view>
    </view>

    <view wx:else class="home-letter done">
      <view class="letter-envelope done">
        <view class="letter-seal-big">✓</view>
        <view class="letter-head">你的声音，小CC收到了</view>
        <view class="letter-done-q">{{letterSaved.q}}</view>
        <view class="letter-done-a">“{{letterSaved.answer}}”</view>
        <view class="letter-echo">这些表达会慢慢长成你的关系画像，也会帮小CC为你找到更合适的见面。</view>
        <view class="letter-actions">
          <button class="letter-btn ghost" bindtap="editHomeLetter">补充一下</button>
          <button class="letter-btn main" bindtap="newHomeLetter">再写一封</button>
        </view>
      </view>
    </view>
    <view class="home-end-space"></view>
  </scroll-view>


    <view wx:elif="{{view === 'activityDetail'}}" class="detail-page">
    <scroll-view scroll-y class="detail-scroll">
      <view class="poster-wrap">
        <image wx:if="{{activeActivity.poster}}" class="detail-poster" src="{{activeActivity.poster}}" mode="aspectFit" />
        <view wx:else class="detail-poster-fallback {{activeActivity.coverClass}}">{{activeActivity.coverText}}</view>
        <button wx:if="{{!activeActivityPast}}" class="share-chip" open-type="share">分享海报＋信息</button>
      </view>

      <view class="info-card">
        <view class="info-title">{{activeActivity.title}}</view>
        <view class="info-sub">{{activeActivity.subtitle}}</view>
        <view class="facts">
          <view class="fact"><text class="fact-label">时间</text><text class="fact-value">{{activeActivity.date}} {{activeActivity.weekday}}</text><text class="fact-sub">{{activeActivity.time}}</text></view>
          <view class="fact"><text class="fact-label">地点</text><text class="fact-value">{{activeActivity.location}}</text></view>
          <view class="fact"><text class="fact-label">人数</text><text class="fact-value">{{activeActivity.people}}</text></view>
          <view class="fact"><text class="fact-label">费用</text><text class="fact-value">{{activeActivity.fee}}</text></view>
        </view>
        <view wx:if="{{activeActivityCapacity && !activeActivityPast}}" class="capacity-status {{activeActivityFull ? 'is-full' : ''}}">
          <text>{{availabilityLoading ? '正在确认名额…' : '已报名 ' + activeActivityRegisteredCount + ' / ' + activeActivityCapacity}}</text>
          <text wx:if="{{!availabilityLoading}}">{{activeActivityFull ? '已满员' : '还剩 ' + activeActivityRemaining + ' 个名额'}}</text>
        </view>
      </view>

      <view class="block">
        <view class="block-title">这场适合你吗</view>
        <view class="block-body">{{activeActivity.crowd}}<text class="block-note">不查条件、不强制配对。你可以先听，也可以表达。</text></view>
      </view>

      <view class="block cc">
        <view class="block-title">为什么推荐给你</view>
        <view class="block-body">{{matchReason}}</view>
      </view>

      <view wx:if="{{activeActivity.schedule && activeActivity.schedule.length}}" class="block">
        <view class="block-title">活动流程</view>
        <view class="schedule">
          <view wx:for="{{activeActivity.schedule}}" wx:key="time" class="step">
            <view class="dot"></view>
            <text class="step-time">{{item.time}}</text>
            <text class="step-text">{{item.title}}</text>
          </view>
        </view>
      </view>

      <view class="block">
        <view class="block-title">安全提醒</view>
        <view class="block-body safety">第一次线下见面，请优先选择公共场所，并将行程告诉一位信任的朋友。</view>
      </view>

      <view wx:if="{{afterPartySpots.length && !activeActivityPast}}" class="block">
        <view class="block-title">听你们的 <text class="block-title-note">散场后，还想一起去哪？</text></view>
        <view class="after-note">根据你今晚的状态挑了 3 个续场灵感，距离与营业情况请出发前再次确认。</view>
        <view wx:for="{{afterPartySpots}}" wx:key="id" class="after-spot">
          <view class="after-spot-head">
            <text class="after-cat">{{item.cat}}</text>
            <text class="after-name">{{item.name}}</text>
            <text class="after-walk">{{item.walk}}</text>
          </view>
          <view class="after-why">{{item.why}}</view>
          <view class="after-tags">
            <text wx:for="{{item.vibe}}" wx:for-item="v" wx:key="*this" class="after-tag">{{v}}</text>
          </view>
        </view>
        <view class="after-actions">
          <button class="after-btn line" bindtap="refreshAfterParty">换一批</button>
          <button class="after-btn solid" bindtap="copyAfterPartyIdeas">复制这三个</button>
        </view>
      </view>

      <view wx:if="{{!activeActivityPast}}" class="detail-links">
        <button class="detail-link warn" data-id="{{activeActivity.id}}" bindtap="dismissCard">不喜欢这类</button>
      </view>
    </scroll-view>

    <view wx:if="{{!activeActivityPast}}" class="detail-bar">
      <button class="bar-btn main" disabled="{{registrationSubmitting || availabilityLoading || (activeActivityFull && !activeActivityRegistered)}}" bindtap="registerActivity">{{registrationSubmitting ? '提交中…' : availabilityLoading ? '正在确认名额…' : activeActivityRegistrationPending ? '已保存，待同步' : activeActivityRegistered ? '取消报名意向' : activeActivityFull ? '已满员' : '提交报名意向'}}</button>
      <button class="bar-btn ghost" bindtap="openReason">我还有顾虑</button>
    </view>
    <view wx:else class="detail-bar history-ended"><button class="bar-btn ended" disabled>活动已结束</button></view>
  </view>

    <scroll-view wx:elif="{{view === 'explore'}}" scroll-y class="screen with-tab explore-page">
    <view class="explore-hero">
      <view class="explore-hero-title">找一场合适的见面</view>
      <view class="explore-hero-desc">按人数、方式和距离选择，不用盲目报名。</view>
    </view>
    <view class="explore-search">
      <input class="explore-input" value="{{exploreSearch}}" bindinput="updateExploreSearch" cursor-spacing="20" placeholder="搜索活动、地点或场景" />
    </view>
    <scroll-view scroll-x class="explore-filters">
      <button class="{{exploreFilter === 'all' ? 'is-active' : ''}}" data-filter="all" bindtap="setExploreFilter">全部</button>
      <button class="{{exploreFilter === 'low' ? 'is-active' : ''}}" data-filter="low" bindtap="setExploreFilter">低压力</button>
      <button class="{{exploreFilter === 'deep' ? 'is-active' : ''}}" data-filter="deep" bindtap="setExploreFilter">深聊</button>
      <button class="{{exploreFilter === 'walk' ? 'is-active' : ''}}" data-filter="walk" bindtap="setExploreFilter">散步</button>
      <button class="{{exploreFilter === 'workshop' ? 'is-active' : ''}}" data-filter="workshop" bindtap="setExploreFilter">工作坊</button>
      <button class="{{exploreFilter === 'lunch' ? 'is-active' : ''}}" data-filter="lunch" bindtap="setExploreFilter">午间</button>
    </scroll-view>
    <scroll-view scroll-x class="explore-filters distance">
      <button class="{{exploreDist === 'all' ? 'is-active' : ''}}" data-filter="all" bindtap="setExploreDist">全部距离</button>
      <button class="{{exploreDist === 'near' ? 'is-active' : ''}}" data-filter="near" bindtap="setExploreDist">3km内</button>
      <button class="{{exploreDist === 'middle' ? 'is-active' : ''}}" data-filter="middle" bindtap="setExploreDist">5km内</button>
      <button class="{{exploreDist === 'sameCity' ? 'is-active' : ''}}" data-filter="sameCity" bindtap="setExploreDist">同城可达</button>
    </scroll-view>
    <view class="explore-list">
      <view wx:for="{{exploreList}}" wx:key="id" class="explore-card" data-id="{{item.id}}" bindtap="openActivity">
        <image class="explore-poster" src="{{item.poster}}" mode="aspectFill" />
        <view class="explore-info">
          <text class="explore-date">{{item.date}} {{item.weekday}} {{item.time}}</text>
          <text class="explore-title">{{item.title}}</text>
          <text class="explore-loc">{{item.location}} · {{item.people}}</text>
          <view class="explore-tags">
            <text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{!exploreList.length}}" class="explore-empty">
      <view class="explore-empty-title">没有找到合适活动</view>
      <button class="explore-clear" bindtap="clearExploreFilter">清除筛选</button>
    </view>
  </scroll-view>

  <scroll-view wx:elif="{{view === 'activityHistory'}}" scroll-y class="screen activity-history-page">
    <view class="history-summary">
      <view><text>{{currentActivityHistory.length}}</text><text>报名意向</text></view>
      <view><text>{{pastActivityHistory.length}}</text><text>过去参与</text></view>
    </view>
    <view class="history-tabs">
      <button class="{{activityHistoryTab === 'past' ? 'active' : ''}}" data-tab="past" bindtap="setActivityHistoryTab">过去参与</button>
      <button class="{{activityHistoryTab === 'current' ? 'active' : ''}}" data-tab="current" bindtap="setActivityHistoryTab">报名意向</button>
    </view>
    <view class="history-list">
      <button wx:for="{{activityHistoryTab === 'past' ? pastActivityHistory : currentActivityHistory}}" wx:key="activityId" class="history-card" data-id="{{item.activityId}}" bindtap="openHistoryActivity">
        <image wx:if="{{item.poster}}" src="{{item.poster}}" mode="aspectFill" />
        <view wx:else class="history-cover {{item.coverClass}}">{{item.coverText || '恰好'}}</view>
        <view class="history-info">
          <text class="history-date">{{item.date}} {{item.weekday}} {{item.time}}</text>
          <text class="history-title">{{item.title}}</text>
          <text class="history-location">{{item.location || '活动地点待确认'}}</text>
          <text class="history-status {{item.status}}">{{item.status === 'pending' ? '待同步' : activityHistoryTab === 'past' ? '已结束' : '报名意向已提交'}}</text>
        </view>
        <text class="row-arrow">›</text>
      </button>
    </view>
    <view wx:if="{{activityHistoryTab === 'past' ? !pastActivityHistory.length : !currentActivityHistory.length}}" class="history-empty">
      <view class="history-empty-title">{{activityHistoryTab === 'past' ? '还没有过去参与的活动' : '还没有报名意向'}}</view>
      <view class="history-empty-desc">{{activityHistoryTab === 'past' ? '完成一次活动后，记录会保留在这里。' : '先找一场你愿意参加的见面。'}}</view>
      <button bindtap="exploreFromHistory">去发现活动</button>
    </view>
  </scroll-view>

    <scroll-view wx:elif="{{view === 'mine'}}" scroll-y class="screen with-tab club-profile">
    <view class="profile-cover"></view>
    <view class="profile-identity">
      <image class="profile-avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
      <image class="profile-avatar" wx:else src="/pages/index/images/portrait-user.jpg" mode="aspectFill" />
      <view class="profile-idtext">
        <view class="profile-name">{{basicInfo.name || '小恰'}}</view>
        <view class="profile-type">{{homeSummary || '低压力线下重启型'}}</view>
      </view>
      <button class="profile-edit" bindtap="editProfile">编辑</button>
    </view>
    <view class="profile-promos">
      <button class="promo-full" bindtap="go" data-view="profile"><text class="promo-title">画像成长</text><text class="promo-sub">继续认识自己</text></button>
    </view>
    <view class="profile-stats">
      <button class="profile-stat-button" bindtap="openActivityHistory"><text class="stat-num">{{registeredActivities.length}}</text><text class="stat-label">参与活动</text></button>
    </view>
    <view class="club-profile-section">
      <view class="section-title">我的记录</view>
      <button bindtap="go" data-view="profile"><text>我的画像</text><text>根据回答和活动反馈持续更新</text><text class="row-arrow">›</text></button>
      <button bindtap="openActivityHistory"><text>参与活动</text><text>{{registeredActivities.length}} 场</text><text class="row-arrow">›</text></button>
      <button wx:if="{{hostToolsEnabled}}" bindtap="openActivityComposer"><text>发布活动</text><text>发起一场恰好见面</text><text class="row-arrow">›</text></button>
    </view>
    <view wx:if="{{publishedActivities.length}}" class="club-profile-section">
      <view class="section-title">我发布的活动</view>
      <view wx:for="{{publishedActivities}}" wx:key="id" class="host-activity-row">
        <view class="host-activity-info">
          <text class="host-activity-title">{{item.title}}</text>
          <text class="host-activity-meta">{{item.date}} {{item.weekday}} {{item.time}} · {{item.status}}</text>
        </view>
        <button class="host-activity-del" data-id="{{item.id}}" catchtap="deletePublishedActivity">下架</button>
      </view>
    </view>
    <view class="mine-logout">
      <button class="logout-btn" bindtap="logoutUser">退出登录</button>
    </view>
  </scroll-view>

  <view wx:if="{{showActivityComposer}}" class="activity-composer" style="bottom: {{composerKeyboardHeight}}px">
    <view class="composer-top">
      <button class="composer-back" bindtap="closeActivityComposer">‹ 返回</button>
      <text>发布活动</text>
      <view class="composer-top-placeholder"></view>
    </view>
    <scroll-view scroll-y enhanced enable-flex class="composer-scroll" scroll-into-view="{{composerScrollIntoView}}">
      <view class="composer-body">
        <!-- 第一板块：活动内容 -->
        <view class="composer-section">
          <view class="composer-section-title">活动内容</view>
          <view class="poster-upload {{activityDraft.poster ? 'has' : ''}}" bindtap="uploadActivityPoster">
            <image wx:if="{{activityDraft.poster}}" class="poster-upload-img" src="{{activityDraft.poster}}" mode="aspectFill" />
            <view wx:else class="poster-upload-plus">
              <text class="poster-upload-plus-icon">＋</text>
              <text class="poster-upload-hint">添加活动封面</text>
            </view>
            <view wx:if="{{activityDraft.poster}}" class="poster-upload-edit">＋ 更换图片</view>
          </view>
          <view class="poster-public-note">封面会随活动公开展示，请不要上传私人照片或敏感信息。</view>
          <view class="form-group" id="composer-title">
            <view class="form-label">活动标题<text class="req">*</text></view>
            <input class="form-input title-gold" value="{{activityDraft.title}}" data-field="title" data-anchor="composer-title" bindfocus="focusActivityField" bindinput="updateActivityDraftField" bindkeyboardheightchange="onActivityKeyboardHeightChange" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="120" confirm-type="next" placeholder="比如：周五轻聊天晚餐局" maxlength="40" />
          </view>
          <view class="form-group" id="composer-intro">
            <view class="form-label">活动介绍</view>
            <textarea class="form-textarea" value="{{activityDraft.subtitle}}" data-field="subtitle" data-anchor="composer-intro" bindfocus="focusActivityField" bindinput="updateActivityDraftField" bindkeyboardheightchange="onActivityKeyboardHeightChange" adjust-position="{{false}}" fixed="{{true}}" cursor-spacing="120" placeholder="写写这场活动会怎么发生（长按可全选、复制）" maxlength="500" />
          </view>
        </view>

        <!-- 第二板块：活动细节 -->
        <view class="composer-section">
          <view class="composer-section-title">活动细节</view>
          <view class="form-group">
            <view class="form-label">活动分类</view>
            <picker mode="selector" range="{{activityTagOptions}}" value="{{categoryIndex}}" bindchange="pickActivityCategory">
              <view class="form-picker">{{activityDraft.category || '请选择活动分类'}} ›</view>
            </picker>
          </view>
          <view class="form-group form-row">
            <view class="form-half">
              <view class="form-label">活动时间<text class="req">*</text></view>
              <picker mode="date" value="{{activityDraft.dateRaw}}" bindchange="pickActivityDate">
                <view class="form-picker">{{activityDraft.date}} {{activityDraft.weekday}}</view>
              </picker>
            </view>
            <view class="form-half">
              <view class="form-label">开始时间</view>
              <picker mode="time" value="{{activityDraft.time}}" bindchange="pickActivityTime">
                <view class="form-picker">{{activityDraft.time}}</view>
              </picker>
            </view>
          </view>
          <view class="form-group" id="composer-location">
            <view class="form-label">活动地点<text class="req">*</text></view>
            <input class="form-input" value="{{activityDraft.location}}" data-field="location" data-anchor="composer-location" bindfocus="focusActivityField" bindinput="updateActivityDraftField" bindkeyboardheightchange="onActivityKeyboardHeightChange" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="120" confirm-type="next" placeholder="比如：KIC / 大学路附近" maxlength="80" />
          </view>
        </view>

        <!-- 第三板块：分组信息 -->
        <view class="composer-section">
          <view class="composer-section-title">分组信息</view>
          <view wx:for="{{activityDraft.groups}}" wx:key="key" class="group-card" id="composer-group-{{index}}">
            <view class="group-head">
              <text>第{{index + 1}}组报名</text>
              <button wx:if="{{activityDraft.groups.length > 1}}" class="group-del" data-index="{{index}}" bindtap="removeActivityGroup">×</button>
            </view>
            <view class="form-row">
              <view class="form-half">
                <view class="form-label">报名人数上限<text class="req">*</text></view>
                <input class="form-input" type="number" value="{{item.people}}" data-index="{{index}}" data-field="people" data-anchor="composer-group-{{index}}" bindfocus="focusActivityField" bindinput="updateActivityGroup" bindkeyboardheightchange="onActivityKeyboardHeightChange" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="120" confirm-type="next" placeholder="比如：8" maxlength="3" />
              </view>
              <view class="form-half">
                <view class="form-label">活动价格</view>
                <input class="form-input" value="{{item.price}}" data-index="{{index}}" data-field="price" data-anchor="composer-group-{{index}}" bindfocus="focusActivityField" bindinput="updateActivityGroup" bindkeyboardheightchange="onActivityKeyboardHeightChange" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="120" confirm-type="done" placeholder="¥99 或 免费" maxlength="30" />
              </view>
            </view>
          </view>
          <button class="group-add" bindtap="addActivityGroup">＋ 新增分组报名</button>
        </view>
      </view>
    </scroll-view>
    <view class="composer-bottom">
      <button class="composer-cancel" bindtap="saveActivityDraft">存草稿</button>
      <button class="composer-publish" disabled="{{activityPublishing}}" bindtap="publishActivity">{{activityPublishing ? '正在发布…' : '发布到活动库'}}</button>
    </view>
  </view>

  <view wx:if="{{showTab}}" class="tab-bar">
    <button class="tab-item {{view === 'home' ? 'active' : ''}}" bindtap="go" data-view="home">专属</button>
    <button class="tab-item {{view === 'explore' ? 'active' : ''}}" bindtap="go" data-view="explore">发现</button>
    <button class="tab-item {{view === 'mine' ? 'active' : ''}}" bindtap="go" data-view="mine">我的</button>
  </view>

  <view wx:if="{{showReasonModal}}" class="modal-mask" bindtap="closeReason">
    <view class="reason-modal" catchtap="noop">
      <view class="modal-title">你还在顾虑什么？</view>
      <view class="modal-desc">反馈只用于改进推荐，不会公开。</view>
      <button wx:for="{{reasonOptions}}" wx:key="*this" class="reason" data-reason="{{item}}" bindtap="closeReason">{{item}}</button>
      <button class="ghost-btn wide" bindtap="closeReason" data-reason="暂不报名">暂不报名</button>
    </view>
  </view>
</view>
