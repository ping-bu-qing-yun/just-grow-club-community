# MySQL（必填）
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 可选：连接池和 TLS
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=10
MYSQL_SSL=false

# 可选：跨实例通知 Redis。留空时使用单进程通知推送。
# 格式：redis://:password@host:6379/0
REDIS_URL=

# 可选：API 监听地址
QIAHAO_API_HOST=127.0.0.1
QIAHAO_API_PORT=3001

# 可选：前端公网地址和额外可信跨域来源（逗号分隔，不支持通配符）
QIAHAO_WEB_ORIGIN=http://127.0.0.1:5174
QIAHAO_CORS_ORIGINS=
