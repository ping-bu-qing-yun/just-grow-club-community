{
  "name": "qiahao-mobile-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=.server-dist/index.js",
    "dev:api": "npm run build:server && node .server-dist/index.js",
    "dev:all": "concurrently -k \"npm:dev:api\" \"npm:dev -- --host 127.0.0.1 --port 5174\"",
    "db:migrate": "tsx server/migrations/run.ts",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "test:server": "vitest server --run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "qa:audit": "playwright test e2e/ui-audit.spec.ts --project=mobile-chrome",
    "start": "npm run build:server && node .server-dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.11.2",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.14.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.10",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
