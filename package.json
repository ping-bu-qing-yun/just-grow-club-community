{
  "name": "qiahao-mobile-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=.server-dist/index.js",
    "dev:api": "npm run build:server && node --env-file-if-exists=.env .server-dist/index.js",
    "dev:all": "concurrently -k \"npm:dev:api\" \"npm:dev -- --host 127.0.0.1 --port 5174\"",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/migrations/run.ts",
    "db:schema:export": "node --env-file-if-exists=.env scripts/export-mysql-schema.mjs",
    "db:config:audit": "node --env-file-if-exists=.env scripts/audit-dynamic-config-compatibility.mjs",
    "build": "tsc -b && vite build",
    "start": "npm run build:server && node --env-file-if-exists=.env .server-dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@tanstack/react-query": "^5.101.4",
    "fastify": "^5.11.2",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.468.0",
    "motion": "^13.0.0",
    "mysql2": "^3.14.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.10",
    "typescript": "^5.9.2",
    "vite": "^8.2.1"
  }
}
